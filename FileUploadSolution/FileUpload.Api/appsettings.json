{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "SharedFolderPath": "\\\\FileServer\\SharedFiles",
    "MaxFileSizeInMB": 20,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".csv",
      ".txt",
      ".png",
      ".jpg",
      ".jpeg"
    ]
  }
}
