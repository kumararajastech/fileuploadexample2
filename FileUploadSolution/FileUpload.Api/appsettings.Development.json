{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "FileStorage": {
    "SharedFolderPath": "C:\\SharedFolderStorage\\Uploads",
    "MaxFileSizeInMB": 20,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".csv",
      ".txt",
      ".png",
      ".jpg",
      ".jpeg"
    ]
  }
}
